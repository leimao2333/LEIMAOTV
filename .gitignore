# Android / Gradle
*.iml
.gradle/
local.properties
.idea/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json

# 签名材料（决定：密钥随仓库走，见 docs/发布流程.md「为什么密钥在仓库里」）
# 只放行这一把密钥与这一份配置，别的 .jks / keystore 一律不进 ——
# 有人临时拷一份别的密钥进来不该被 git add -A 顺手带走
*.jks
*.keystore
keystore/*
!keystore/leimao-tv.jks

# 本地演练发版流程时留下的校验和文件（正式的由 CI 生成并上传 Release）
*.apk.sha256

# 系统与编辑器
.DS_Store
Thumbs.db
*.swp
*~

# 本地调试产物（截图 / 界面层级转储 / 日志），随手生成、不入库
# 验收截图同理：docs/verify/ 是模拟器实拍的证据目录，单张 2~3MB，77 张就 30MB，
# 进 git 会把仓库撑成一个图片仓库。留在本地用作验收凭据，结论写进 docs/ 的正文
/*.png
/*.xml
docs/verify/
*.log
crashlogs/
.backup/

# AI 协作工具的项目数据（会话记忆等）
.workbuddy/
.workbuddy-ai/

# 测试与临时目录
/tmp/
