<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只用于拉取用户自己添加的订阅源；不上传任何东西（RULES §1：无账号体系、无数据上传） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 应用内更新（SET-07）：下载新版包后交给系统安装器。声明它只为了「能发起安装」，
         装与不装由系统界面上的用户决定，应用无法静默替换自己 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 开机自启动（SET-08）：受保护权限，只有系统会发 BOOT_COMPLETED。
         接收器内部还要再查开关（默认关），关着时收到广播什么都不做 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- required=false：盒子不一定声明 leanback，但仍是电视设备；置 true 会让部分盒子装不上 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- 电视没有触摸屏。漏了这行，Play 会把应用归为「需要触摸」，电视端直接搜不到 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".LeimaoTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeimaoTv">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 只声明 LEANBACK_LAUNCHER：目标设备就是电视，不做手机端入口（RULES §1） -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 更新包的分享出口（SET-07）：安装器是另一个进程，读我们的 cacheDir 必须走 content:// +
             一次性读授权。authorities 用 ${applicationId} 占位，debug 包（带 .debug 后缀）也自动对上 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机自启动（SET-08）。exported=true 是收系统广播所必需的，但 BOOT_COMPLETED
             是受保护广播，第三方应用发不进来 —— 能触发它的只有系统 -->
        <receiver
            android:name=".startup.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
