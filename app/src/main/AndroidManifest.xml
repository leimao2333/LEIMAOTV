<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只用于拉取用户自己添加的订阅源；不上传任何东西（RULES §1：无账号体系、无数据上传） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 应用内更新（SET-07）：下载新版包后交给系统安装器。声明它只为了「能发起安装」，
         装与不装由系统界面上的用户决定，应用无法静默替换自己 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 开机自启动（SET-08）：受保护权限，只有系统会发 BOOT_COMPLETED。
         接收器内部还要再查开关（默认关），关着时收到广播什么都不做 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- required=false：盒子不一定声明 leanback，但仍是电视设备；置 true 会让部分盒子装不上 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- 电视没有触摸屏。漏了这行，Play 会把应用归为「需要触摸」，电视端直接搜不到 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- 包可见性（Android 11+）：源管理要查「这台机器有没有文件选择器」——
         查不到就没人接 OPEN_DOCUMENT，得提前告诉用户改用地址导入，而不是按下去没反应。
         不声明 queries 的话 queryIntentActivities 永远返回空，会把有选择器的机器误判成没有。
         这里只声明我们真正会去问的三个动作，不涉及任何其它应用的信息 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".LeimaoTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeimaoTv">

        <!-- activity 上再声明一次 banner：多数桌面读的是 ApplicationInfo.banner（application 上的那份），
             但部分 ROM 的桌面走 PackageManager.getActivityBanner，只认 ActivityInfo.banner，
             不回落到 application —— 不声明就在那些机器上只剩名字、没有横幅 -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <!-- 两条入口必须并存（2026-11-01 修「电视装完桌面里没有图标」）：
                 原生 Android TV / Google TV 的启动器只认 LEANBACK_LAUNCHER；
                 国产电视与盒子（小米 / 海信 / TCL / 当贝 / 各类安卓盒子）的自带桌面基本只扫
                 LAUNCHER —— 只声明 LEANBACK 时，它们压根不会为这个包建桌面项，
                 `pm list packages` 能看到、桌面上却找不到，也就是「装好了点不进去」。

                 这不算「开手机端入口」：LAUNCHER 只是让非 Leanback 的桌面也能列出它，
                 目标设备仍然是电视。RULES §1 禁止的是「手机专属交互作为唯一入口」与内容分发，
                 不是禁止这个 category（2026-10-26 只在 debug 里打的补丁已经证明判断没错，
                 但那版补丁救不了正式包）。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 更新包的分享出口（SET-07）：安装器是另一个进程，读我们的 cacheDir 必须走 content:// +
             一次性读授权。authorities 用 ${applicationId} 占位，debug 包（带 .debug 后缀）也自动对上 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机自启动（SET-08）。exported=true 是收系统广播所必需的，但 BOOT_COMPLETED
             是受保护广播，第三方应用发不进来 —— 能触发它的只有系统 -->
        <receiver
            android:name=".startup.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
