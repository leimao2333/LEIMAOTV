<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只用于拉取用户自己添加的订阅源；不上传任何东西（RULES §1：无账号体系、无数据上传） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- required=false：盒子不一定声明 leanback，但仍是电视设备；置 true 会让部分盒子装不上 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- 电视没有触摸屏。漏了这行，Play 会把应用归为「需要触摸」，电视端直接搜不到 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".LeimaoTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeimaoTv">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 只声明 LEANBACK_LAUNCHER：目标设备就是电视，不做手机端入口（RULES §1） -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
